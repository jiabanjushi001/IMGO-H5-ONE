# shell 格式；systemd 环境文件也支持。不要提交 .env。
IMGO_ADDR=127.0.0.1:8080
MYSQL_DSN='imgo:CHANGE_ME@tcp(127.0.0.1:3306)/imgo?charset=utf8mb4&loc=Local'
TABLE_PREFIX=yu_
JWT_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
# 原 PHP CHAT_KEY 必须原样保留；旧库为明文时留空。不要用旧 JWT_KEY。
CHAT_KEY=''
PUBLIC_DIR=public
BASE_URL=http://localhost:8080
# 二维码公开地址；手机内网测试可设为 H5 预览代理地址，留空沿用 BASE_URL。
QR_BASE_URL=
# H5 根地址（不含 # 路由）；群二维码的浏览器跳转会使用它。
H5_URL=http://localhost:8765/
# 邀请注册完整地址前缀，后端仅追加 token；留空使用原 PC 注册页
INVITE_URL=
SMTP_ADDR=''
SMTP_USER=''
SMTP_PASSWORD=''
SMTP_FROM=''
API_APP_ID=''
API_SECRET=''
# 可选：下载客户端时使用的受信任本地安装包绝对路径
APP_WINDOWS_FILE=''
APP_MAC_FILE=''
APP_ANDROID_FILE=''
# 默认只信任同机 Nginx（IPv4/IPv6 回环地址）；仅在代理位于其他机器时修改。
TRUSTED_PROXIES='127.0.0.1,::1'
# 后台尚未保存清理配置时的初始默认值；后台保存后以数据库配置为准。
MAINTENANCE_ENABLED=false

# 内容审核：为空时不调用；使用原 ThinkAPI AppCode。
THINKAPI_TOKEN=''
# 兼容原项目的历史 IPv4 属地库（数据版本较旧）。
IP_DATABASE=data/17monipdb.dat
# 视频抽帧：可选，填写可信 FFmpeg/ffprobe 二进制绝对路径。
FFMPEG_BIN=''
FFPROBE_BIN=''
