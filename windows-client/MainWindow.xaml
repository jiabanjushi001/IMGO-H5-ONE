<Window x:Class="Imgo.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Imgo.Desktop"
        Title="IMGO" Width="1200" Height="780" MinWidth="920" MinHeight="500"
        WindowStartupLocation="CenterScreen" Background="#F7F9F8" Foreground="{StaticResource Ink}"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13" UseLayoutRounding="True" PreviewKeyDown="ChatShortcuts">
    <Window.TaskbarItemInfo>
        <TaskbarItemInfo/>
    </Window.TaskbarItemInfo>
    <Window.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="ChatTheme.xaml"/>
        </ResourceDictionary.MergedDictionaries>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility"/>
        <DrawingImage x:Key="UnreadIndicator">
            <DrawingImage.Drawing>
                <GeometryDrawing Brush="{StaticResource ChatUnread}">
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry Center="8,8" RadiusX="8" RadiusY="8"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingImage.Drawing>
        </DrawingImage>
        <Style TargetType="ListBox">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
        </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="White" Padding="13,5" BorderBrush="{StaticResource ChatLine}" BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="添加账号" Click="AddAccount" Style="{StaticResource ChatQuietAction}"/>
                    <Button x:Name="AdminButton" Content="管理中心" Click="ToggleAdmin" Visibility="Collapsed"
                            Style="{StaticResource ChatQuietAction}"/>
                    <Button x:Name="SignOutButton" Content="退出账号" Click="SignOut" Style="{StaticResource ChatQuietAction}"/>
                </StackPanel>
                <TextBlock DockPanel.Dock="Left" Text="IMGO" FontSize="15" FontWeight="Bold"
                           VerticalAlignment="Center" Margin="5,0,12,0" Foreground="{StaticResource ChatInk}"/>
                <ComboBox x:Name="Accounts" DockPanel.Dock="Left" Width="156" Margin="0,0,8,0"
                          SelectionChanged="AccountChanged" AutomationProperties.Name="当前账号">
                    <ComboBox.ItemTemplate>
                        <DataTemplate><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"/></DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock x:Name="OtherUnread" Foreground="{StaticResource ChatAccent}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" Margin="4,0,0,0"/>
            </DockPanel>
        </Border>

        <Border x:Name="ChatWorkspace" Grid.Row="1" ClipToBounds="True" TextElement.Foreground="{StaticResource ChatInk}">
          <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="58"/><ColumnDefinition x:Name="ChatListColumn" Width="240"/>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Background="{StaticResource ChatRail}" Padding="6,11,6,5">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom">
                        <Button x:Name="ProfileRailButton" Style="{StaticResource ChatRailAction}" Click="OpenChatSettings" AutomationProperties.Name="设置">
                            <StackPanel><TextBlock Text="&#xE713;" Style="{StaticResource ChatRailIcon}"/><TextBlock Text="设置" Style="{StaticResource ChatRailLabel}"/></StackPanel>
                        </Button>
                        <Button Style="{StaticResource ChatRailAction}" Click="ToggleFullScreen" ToolTip="全屏 / 窗口 (F11)" AutomationProperties.Name="全屏或窗口">
                            <StackPanel><TextBlock Text="&#xE740;" Style="{StaticResource ChatRailIcon}"/><TextBlock Text="全屏" Style="{StaticResource ChatRailLabel}"/></StackPanel>
                        </Button>
                    </StackPanel>
                    <StackPanel>
                        <Button x:Name="ChatRailButton" Style="{StaticResource ChatRailAction}" Background="{StaticResource ChatRailActive}"
                                Click="ShowChatRail" AutomationProperties.Name="聊天">
                            <StackPanel><TextBlock Text="&#xE8BD;" Style="{StaticResource ChatRailIcon}"/><TextBlock Text="聊天" Style="{StaticResource ChatRailLabel}"/></StackPanel>
                        </Button>
                        <Button x:Name="DirectoryRailButton" Style="{StaticResource ChatRailAction}" Click="OpenContactDirectory" AutomationProperties.Name="通讯录">
                            <StackPanel><TextBlock Text="&#xE779;" Style="{StaticResource ChatRailIcon}"/><TextBlock Text="通讯录" Style="{StaticResource ChatRailLabel}"/></StackPanel>
                        </Button>
                        <Button x:Name="FilesRailButton" Style="{StaticResource ChatRailAction}" Click="OpenFileLibrary" AutomationProperties.Name="文件">
                            <StackPanel><TextBlock Text="&#xE8B7;" Style="{StaticResource ChatRailIcon}"/><TextBlock Text="文件" Style="{StaticResource ChatRailLabel}"/></StackPanel>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border x:Name="ConversationListPane" Grid.Column="1" Background="{StaticResource ChatDirectory}" BorderBrush="{StaticResource ChatLine}" BorderThickness="0,0,1,0" Padding="9,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Margin="2,2,2,10">
                        <DockPanel Margin="0,0,0,10">
                            <Button x:Name="ContactsMenuButton" DockPanel.Dock="Right" Content="＋" Click="OpenContactsMenu"
                                    ToolTip="添加好友或群聊" AutomationProperties.Name="添加好友或群聊" Margin="0" MinWidth="32" Style="{StaticResource ChatQuietAction}"/>
                            <TextBlock Text="会话" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </DockPanel>
                        <Grid>
                            <TextBox x:Name="ConversationSearch" Style="{StaticResource ChatSearchInput}" ToolTip="Ctrl + F 搜索会话" Padding="30,6,10,6" TextChanged="ConversationFilterChanged"
                                     AutomationProperties.Name="搜索会话"/>
                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource ChatMuted}"
                                       VerticalAlignment="Center" Margin="10,0,0,0" IsHitTestVisible="False"/>
                            <TextBlock Text="搜索会话" Foreground="{StaticResource ChatMuted}"
                                       VerticalAlignment="Center" Margin="31,0,0,0" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=ConversationSearch}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <Border Background="{StaticResource ChatInset}" CornerRadius="9" Padding="3" Margin="0,10,0,0">
                            <UniformGrid Rows="1" Columns="3">
                                <RadioButton x:Name="OnlyAll" Content="所有" GroupName="ConversationScope" IsChecked="True" Checked="ConversationFilterChanged"
                                             Style="{StaticResource ChatFilter}"/>
                                <RadioButton x:Name="OnlyUnread" Content="未读" GroupName="ConversationScope" Checked="ConversationFilterChanged"
                                             Style="{StaticResource ChatFilter}"/>
                                <RadioButton x:Name="OnlyMentions" Content="@我" GroupName="ConversationScope" Checked="ConversationFilterChanged"
                                             Style="{StaticResource ChatFilter}"/>
                            </UniformGrid>
                        </Border>
                    </StackPanel>
                    <ListBox Grid.Row="1" x:Name="Contacts" Background="Transparent" SelectedValuePath="Id" SelectionChanged="ContactChanged">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource ChatDirectoryRow}">
                                <EventSetter Event="PreviewMouseRightButtonUp" Handler="OpenConversationRowMenu"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="46"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="36" Height="36" HorizontalAlignment="Left" CornerRadius="9"
                                            Background="{StaticResource ChatTint}">
                                        <Grid ClipToBounds="True">
                                            <TextBlock Text="{Binding Initial}" Foreground="{StaticResource ChatAccent}" FontWeight="SemiBold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <Image Stretch="UniformToFill" OpacityMask="{StaticResource ChatAvatarMask}" Loaded="LoadThumbnail" DataContextChanged="ThumbnailDataChanged"/>
                                            <Ellipse Width="9" Height="9" Fill="#2DA675" Stroke="White" StrokeThickness="1.5"
                                                     HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                     Visibility="{Binding Online, Converter={StaticResource BooleanToVisibility}}"/>
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,7,0">
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Preview}" TextTrimming="CharacterEllipsis"
                                                   Foreground="{StaticResource ChatMuted}" FontSize="12" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding LastTime}" Foreground="{StaticResource ChatMuted}" FontSize="10"
                                                   HorizontalAlignment="Right"/>
                                        <Border Background="{StaticResource ChatUnread}" CornerRadius="8" MinWidth="17" Padding="4,0"
                                                Margin="0,4,0,0" HorizontalAlignment="Right" Visibility="{Binding HasUnread, Converter={StaticResource BooleanToVisibility}}">
                                            <TextBlock Text="{Binding Badge}" Foreground="White" FontSize="10" HorizontalAlignment="Center"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Grid.Row="1" x:Name="ConversationEmpty" Visibility="Collapsed" TextWrapping="Wrap" TextAlignment="Center"
                               Foreground="{StaticResource ChatMuted}" VerticalAlignment="Center" Margin="12" IsHitTestVisible="False"/>
                </Grid>
            </Border>

            <Border x:Name="ConversationPane" Grid.Column="2" Background="White" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border BorderBrush="{StaticResource ChatLine}" BorderThickness="0,0,0,1" Padding="16,9">
                        <DockPanel>
                            <Button x:Name="GroupSettingsButton" DockPanel.Dock="Right" Style="{StaticResource ChatQuietAction}"
                                    Content="群设置" Visibility="Collapsed" Click="OpenGroupSettings" Margin="8,0,0,0"/>
                            <Button x:Name="GroupNoticeButton" DockPanel.Dock="Right" Style="{StaticResource ChatQuietAction}"
                                    Content="群公告" Visibility="Collapsed" Click="OpenGroupNotice" Margin="8,0,0,0"/>
                            <Button x:Name="NetworkProfileButton" DockPanel.Dock="Right" Style="{StaticResource ChatQuietAction}" Content="详细资料" Click="OpenNetworkProfile"
                                    Visibility="Collapsed" Margin="8,0,0,0" ToolTip="查看 IP、注册和登录详情"/>
                            <Button x:Name="ConversationMenuButton" DockPanel.Dock="Right" Style="{StaticResource ChatQuietAction}" Content="•••" Click="OpenCurrentConversationMenu"
                                    ToolTip="会话操作" AutomationProperties.Name="会话操作" Margin="8,0,0,0"/>
                            <Button x:Name="OlderButton" DockPanel.Dock="Right" Style="{StaticResource ChatQuietAction}" Content="加载更早消息" ToolTip="查看更早的聊天记录"
                                    IsEnabled="False" Margin="8,0,0,0" Click="LoadOlder" AutomationProperties.Name="加载更早消息"/>
                            <Button x:Name="VideoCallButton" DockPanel.Dock="Right" Style="{StaticResource ChatQuietAction}"
                                    Content="视频通话" Visibility="Collapsed" Margin="6,0,0,0" Click="StartVideoCall"/>
                            <Button x:Name="VoiceCallButton" DockPanel.Dock="Right" Style="{StaticResource ChatQuietAction}"
                                    Content="语音通话" Visibility="Collapsed" Margin="6,0,0,0" Click="StartVoiceCall"/>
                            <DockPanel VerticalAlignment="Center">
                                <Border x:Name="ChatAvatar" DockPanel.Dock="Left" Width="36" Height="36" CornerRadius="10"
                                        Background="{StaticResource ChatTint}" Margin="0,0,9,0" Visibility="Collapsed">
                                    <Grid ClipToBounds="True">
                                        <TextBlock x:Name="ChatInitial" Foreground="{StaticResource ChatAccent}" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Image x:Name="ChatAvatarImage" Stretch="UniformToFill" OpacityMask="{StaticResource ChatAvatarMask}" Loaded="LoadThumbnail" DataContextChanged="ThumbnailDataChanged"/>
                                    </Grid>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="ChatTitle" Text="聊天" FontWeight="SemiBold" FontSize="17" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="ChatKind" TextTrimming="CharacterEllipsis" Foreground="{StaticResource ChatMuted}" FontSize="11" Margin="0,2,0,0" Visibility="Collapsed"/>
                                </StackPanel>
                            </DockPanel>
                        </DockPanel>
                    </Border>
                    <Grid Grid.Row="1" Background="{StaticResource ChatCanvas}">
                        <ListBox x:Name="Messages" Background="Transparent" Padding="15,10"
                                 VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.IsDeferredScrollingEnabled="True">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Focusable" Value="False"/>
                                    <Setter Property="Padding" Value="8,2"/>
                                    <Setter Property="Template">
                                        <Setter.Value><ControlTemplate TargetType="ListBoxItem">
                                            <Border Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Stretch"/></Border>
                                        </ControlTemplate></Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <Border HorizontalAlignment="Center" Background="#E3EAE6" CornerRadius="9"
                                                Padding="9,3" Margin="0,13,0,11">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding TimeDivider}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding TimeDivider}" FontSize="11" Foreground="{StaticResource ChatMuted}"/>
                                        </Border>
                                        <DockPanel MaxWidth="482">
                                            <DockPanel.Style>
                                                <Style TargetType="DockPanel">
                                                    <Setter Property="HorizontalAlignment" Value="Left"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMine}" Value="True"><Setter Property="HorizontalAlignment" Value="Right"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding Type}" Value="event"><Setter Property="HorizontalAlignment" Value="Center"/></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </DockPanel.Style>
                                            <Border Width="32" Height="32" CornerRadius="8" VerticalAlignment="Top" ClipToBounds="True"
                                                    Background="{StaticResource ChatTint}" ToolTip="{Binding Sender}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="DockPanel.Dock" Value="Left"/>
                                                        <Setter Property="Margin" Value="0,0,8,0"/>
                                                        <Setter Property="Visibility" Value="Hidden"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsMine}" Value="True">
                                                                <Setter Property="DockPanel.Dock" Value="Right"/>
                                                                <Setter Property="Margin" Value="8,0,0,0"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding ShowAvatar}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                            <DataTrigger Binding="{Binding Type}" Value="event"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <TextBlock Text="{Binding AvatarInitial}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Foreground="{StaticResource ChatAccent}" FontWeight="SemiBold"/>
                                                    <Image Tag="sender-avatar" Stretch="UniformToFill" OpacityMask="{StaticResource ChatAvatarMask}"
                                                           Visibility="{Binding ShowAvatar, Converter={StaticResource BooleanToVisibility}}"
                                                           Loaded="LoadThumbnail" DataContextChanged="ThumbnailDataChanged"/>
                                                </Grid>
                                            </Border>
                                            <StackPanel MaxWidth="442">
                                                <TextBlock Text="{Binding Sender}" Margin="1,0,1,4" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                           Foreground="{StaticResource ChatMuted}"
                                                           Visibility="{Binding ShowSender, Converter={StaticResource BooleanToVisibility}}"/>
                                        <Border Padding="11,6" BorderThickness="1">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="White"/>
                                                    <Setter Property="BorderBrush" Value="{StaticResource ChatBubbleEdge}"/>
                                                    <Setter Property="CornerRadius" Value="5,12,12,12"/>
                                                    <Style.Triggers><DataTrigger Binding="{Binding IsMine}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource OutgoingBubble}"/>
                                                        <Setter Property="BorderBrush" Value="{StaticResource OutgoingBorder}"/>
                                                        <Setter Property="CornerRadius" Value="12,5,12,12"/>
                                                    </DataTrigger></Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel>
                                                <StackPanel.ContextMenu>
                                                    <ContextMenu Opened="ConfigureMessageMenu">
                                                        <MenuItem Header="复制" Tag="copy" Click="MessageMenuAction"/>
                                                        <MenuItem Header="引用回复" Tag="reply" Click="MessageMenuAction"/>
                                                        <MenuItem Header="转发" Tag="forward" Click="MessageMenuAction"/>
                                                        <Separator/>
                                                        <MenuItem Header="收藏为表情" Tag="emoji" Click="MessageMenuAction"/>
                                                        <MenuItem Header="撤回" Tag="undo" Click="MessageMenuAction"/>
                                                        <MenuItem Header="从我的记录移除" Tag="remove" Click="MessageMenuAction"/>
                                                    </ContextMenu>
                                                </StackPanel.ContextMenu>
                                                <Border BorderThickness="2,0,0,0" BorderBrush="#91B9A4" Background="#28FFFFFF"
                                                        Padding="7,2,4,2" Margin="0,0,0,6"
                                                        Visibility="{Binding HasQuote, Converter={StaticResource BooleanToVisibility}}">
                                                    <TextBlock Text="{Binding Quote}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource ChatMuted}" FontSize="12"/>
                                                </Border>
                                                <TextBlock Text="{Binding Body}" TextWrapping="Wrap" FontSize="14" LineHeight="20"/>
                                                <StackPanel Visibility="{Binding HasAttachment, Converter={StaticResource BooleanToVisibility}}"
                                                            Margin="0,6,0,0">
                                                    <Border Width="188" Height="112" Background="#EDF4EF" HorizontalAlignment="Left"
                                                            CornerRadius="5" Margin="0,0,0,5"
                                                            Visibility="{Binding HasThumbnail, Converter={StaticResource BooleanToVisibility}}">
                                                        <Grid ClipToBounds="True">
                                                            <TextBlock Text="&#xEB9F;" FontFamily="Segoe MDL2 Assets" FontSize="17"
                                                                       Foreground="{StaticResource ChatMuted}" HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center" IsHitTestVisible="False"/>
                                                            <Image Stretch="Uniform" Loaded="LoadThumbnail" DataContextChanged="ThumbnailDataChanged"/>
                                                        </Grid>
                                                    </Border>
                                                    <TextBlock Text="{Binding AttachmentLabel}" TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding AttachmentLabel}" Margin="0,0,0,6"/>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Button Content="预览图片" Click="PreviewAttachment" Style="{StaticResource ChatQuietAction}" MinHeight="27" Padding="7,2"
                                                                Visibility="{Binding IsImage, Converter={StaticResource BooleanToVisibility}}"/>
                                                        <Button Content="播放" Click="PlayAttachment" Style="{StaticResource ChatQuietAction}" MinHeight="27" Padding="7,2"
                                                                Visibility="{Binding IsPlayable, Converter={StaticResource BooleanToVisibility}}"/>
                                                        <Button Content="保存文件" Click="SaveAttachment" Style="{StaticResource ChatQuietAction}" MinHeight="27" Padding="7,2" Margin="0"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                                <TextBlock Text="{Binding Receipt}" HorizontalAlignment="Right" FontSize="10"
                                                           Foreground="{StaticResource ChatMuted}" Margin="0,2,0,1">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Receipt}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </DockPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel x:Name="ChatEmpty" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
                            <Border Width="48" Height="48" CornerRadius="13" HorizontalAlignment="Center" Background="{StaticResource ChatTint}">
                                <TextBlock Text="&#xE8BD;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="{StaticResource ChatAccent}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock x:Name="ChatEmptyText" Text="从左侧选择会话" Foreground="{StaticResource ChatMuted}"
                                       HorizontalAlignment="Center" Margin="0,9,0,0"/>
                        </StackPanel>
                    </Grid>
                    <Border Grid.Row="2" Background="{StaticResource ChatCanvas}" Padding="13,0,13,10">
                      <Border Background="White" BorderBrush="{StaticResource ChatLine}" BorderThickness="1"
                              CornerRadius="13" Padding="9,4,9,7">
                      <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <DockPanel x:Name="EditorTools" Margin="0,0,0,3">
                            <Button DockPanel.Dock="Right" Click="OpenMessageManager" Style="{StaticResource ChatCompactTool}" VerticalAlignment="Top"
                                    ToolTip="消息记录" AutomationProperties.Name="消息记录">
                                <TextBlock Text="&#xE81C;" Style="{StaticResource ChatCompactIcon}"/>
                            </Button>
                            <WrapPanel>
                                <Button x:Name="EmojiButton" ToolTip="表情" AutomationProperties.Name="表情" Click="OpenEmoji" Style="{StaticResource ChatCompactTool}">
                                    <TextBlock Text="&#xE899;" Style="{StaticResource ChatCompactIcon}"/>
                                </Button>
                                <Button AutomationProperties.Name="截图" Click="StartScreenshot" Style="{StaticResource ChatCompactTool}"
                                        ToolTip="截图 · 截图后在输入框按 Ctrl+V">
                                    <TextBlock Text="&#xE722;" Style="{StaticResource ChatCompactIcon}"/>
                                </Button>
                                <Button AutomationProperties.Name="图片" ToolTip="图片" Click="PickTypedAttachment" Tag="image" Style="{StaticResource ChatCompactTool}">
                                    <TextBlock Text="&#xEB9F;" Style="{StaticResource ChatCompactIcon}"/>
                                </Button>
                                <Button AutomationProperties.Name="语音" ToolTip="语音" Click="OpenVoiceMenu" Style="{StaticResource ChatCompactTool}">
                                    <TextBlock Text="&#xE720;" Style="{StaticResource ChatCompactIcon}"/>
                                </Button>
                                <Button AutomationProperties.Name="视频" ToolTip="视频" Click="PickTypedAttachment" Tag="video" Style="{StaticResource ChatCompactTool}">
                                    <TextBlock Text="&#xE714;" Style="{StaticResource ChatCompactIcon}"/>
                                </Button>
                                <Button x:Name="AttachmentButton" AutomationProperties.Name="文件" ToolTip="文件" Click="PickAttachment" Style="{StaticResource ChatCompactTool}">
                                    <TextBlock Text="&#xE8A5;" Style="{StaticResource ChatCompactIcon}"/>
                                </Button>
                                <Button x:Name="MentionButton" Content="＠" Click="ChooseMention" Style="{StaticResource ChatCompactTool}"
                                        ToolTip="提及群成员" AutomationProperties.Name="提及群成员"/>
                            </WrapPanel>
                        </DockPanel>
                        <Border Grid.Row="1" x:Name="QuoteBar" Visibility="Collapsed" Background="{StaticResource ChatTint}"
                                CornerRadius="7" Padding="8,2" Margin="0,0,0,6">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="×" Click="ClearQuote" MinHeight="24" Padding="6,0"
                                        Margin="0" AutomationProperties.Name="取消引用"/>
                                <TextBlock x:Name="QuoteText" Margin="0,0,6,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>
                        <TextBox Grid.Row="2" x:Name="Compose" Style="{StaticResource ChatComposeInput}" AllowDrop="True" PreviewDragOver="ComposeDragOver" PreviewDrop="ComposeDrop" Height="61" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="0"
                                 VerticalScrollBarVisibility="Auto" IsEnabled="False" KeyDown="ComposeKeyDown"
                                 TextChanged="ComposeChanged" AutomationProperties.Name="消息内容"/>
                        <DockPanel Grid.Row="3" Margin="0,7,0,0">
                            <Button x:Name="SendButton" Style="{StaticResource ChatPrimaryAction}" DockPanel.Dock="Right"
                                    Content="发送" Click="SendMessage" MinWidth="84" Margin="0" IsEnabled="False"/>
                            <Button x:Name="QuickReplyButton" Style="{StaticResource ChatQuietAction}" DockPanel.Dock="Left" Content="快捷用语" Click="ShowQuickReplies"
                                    MinHeight="30" IsEnabled="False"/>
                            <TextBlock x:Name="ComposeHint" Text="Ctrl + Enter 发送" VerticalAlignment="Center" HorizontalAlignment="Right"
                                       Margin="8,0,10,0" Foreground="{StaticResource ChatMuted}" FontSize="11"/>
                        </DockPanel>
                      </Grid>
                      </Border>
                    </Border>
                </Grid>
            </Border>
            <Border x:Name="DirectoryListPane" Grid.Column="1" Visibility="Collapsed" Background="{StaticResource ChatDirectory}"
                    BorderBrush="{StaticResource ChatLine}" BorderThickness="0,0,1,0" Padding="9,10">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="1,2,1,8">
                        <DockPanel Margin="0,0,0,9">
                            <Button x:Name="DirectoryAddButton" DockPanel.Dock="Right" Content="＋" Click="OpenContactsMenu"
                                    ToolTip="添加好友或群聊" Style="{StaticResource ChatQuietAction}" Margin="0"/>
                            <TextBlock Text="通讯录" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </DockPanel>
                        <Grid>
                            <TextBox x:Name="DirectorySearch" Style="{StaticResource ChatSearchInput}" Padding="30,6,10,6"
                                     AutomationProperties.Name="搜索通讯录" ToolTip="搜索昵称、账号或群号" TextChanged="DirectoryFilterChanged"/>
                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource ChatMuted}"
                                       VerticalAlignment="Center" Margin="10,0,0,0" IsHitTestVisible="False"/>
                            <TextBlock Text="搜索通讯录" Foreground="{StaticResource ChatMuted}"
                                       VerticalAlignment="Center" Margin="31,0,0,0" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=DirectorySearch}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <Border Background="{StaticResource ChatInset}" CornerRadius="9" Padding="3" Margin="0,8,0,0">
                            <UniformGrid Rows="1" Columns="3">
                                <RadioButton x:Name="DirectoryAll" IsChecked="True" GroupName="DirectoryScope" Content="全部"
                                             Style="{StaticResource ChatFilter}" Checked="DirectoryFilterChanged"/>
                                <RadioButton x:Name="DirectoryFriends" GroupName="DirectoryScope" Content="联系人"
                                             Style="{StaticResource ChatFilter}" Checked="DirectoryFilterChanged"/>
                                <RadioButton x:Name="DirectoryGroups" GroupName="DirectoryScope" Content="群聊"
                                             Style="{StaticResource ChatFilter}" Checked="DirectoryFilterChanged"/>
                            </UniformGrid>
                        </Border>
                    </StackPanel>
                    <Grid>
                        <ListBox x:Name="DirectoryEntries" Background="Transparent" BorderThickness="0" SelectedValuePath="Id"
                                 ItemContainerStyle="{StaticResource ChatDirectoryRow}"
                                 SelectionChanged="DirectorySelectionChanged" MouseDoubleClick="DirectoryEntryDoubleClick" KeyDown="DirectoryEntryKeyDown">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="4,6">
                                        <Border Width="34" Height="34" CornerRadius="9" Background="{StaticResource ChatTint}"
                                                DockPanel.Dock="Left" Margin="0,0,9,0" ClipToBounds="True">
                                            <Grid>
                                                <TextBlock Text="{Binding Initial}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           FontWeight="SemiBold" Foreground="{StaticResource ChatAccent}"/>
                                                <Image Stretch="UniformToFill" OpacityMask="{StaticResource ChatAvatarMask}" Loaded="LoadThumbnail" DataContextChanged="ThumbnailDataChanged"/>
                                            </Grid>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Kind}" FontSize="11" Foreground="{StaticResource ChatMuted}"/>
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="DirectoryEmpty" Text="暂无联系人" Foreground="{StaticResource ChatMuted}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                    </Grid>
                </DockPanel>
            </Border>
            <Border x:Name="DirectoryProfilePane" Grid.Column="2" Visibility="Collapsed" Background="White" Padding="32,30">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="DirectoryProfile" MaxWidth="520" HorizontalAlignment="Stretch"/>
                </ScrollViewer>
            </Border>
            <Border x:Name="ConversationSidePane" Grid.Column="3" Width="320" Visibility="Collapsed" Background="White"
                    BorderBrush="{StaticResource ChatLine}" BorderThickness="1,0,0,0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" BorderBrush="{StaticResource ChatLine}" BorderThickness="0,0,0,1" Padding="10,8">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="×" Click="CloseConversationPane" ToolTip="关闭侧栏"
                                    AutomationProperties.Name="关闭侧栏" Style="{StaticResource ChatQuietAction}" Margin="0"/>
                            <Button x:Name="ConversationSideBack" DockPanel.Dock="Left" Content="‹" Click="BackConversationPane" ToolTip="返回"
                                    AutomationProperties.Name="返回上一层" Visibility="Collapsed" Style="{StaticResource ChatQuietAction}"/>
                            <TextBlock x:Name="ConversationSideTitle" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" Margin="4,0"/>
                        </DockPanel>
                    </Border>
                    <ContentControl x:Name="ConversationSideContent" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
                </DockPanel>
            </Border>
          </Grid>
        </Border>

        <local:AdminWorkspace x:Name="Admin" Grid.Row="1" Visibility="Collapsed"/>

        <DockPanel Grid.Row="2" MinHeight="20" Margin="8,2,8,1">
            <TextBlock x:Name="Connection" DockPanel.Dock="Right" Foreground="{StaticResource ChatMuted}" Margin="16,0,0,0"/>
            <TextBlock x:Name="Status" Text="添加账号后开始聊天" TextWrapping="Wrap" Foreground="{StaticResource ChatMuted}"/>
        </DockPanel>

        <Border x:Name="LoginPanel" Grid.RowSpan="3" Panel.ZIndex="1" Visibility="Collapsed"
                Background="#70203731">
            <Border Background="White" Width="418" Padding="25" CornerRadius="14"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="添加账号" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <Label Content="Go API 地址" Target="{Binding ElementName=ServerAddress}"/>
                    <TextBox x:Name="ServerAddress" Style="{StaticResource ChatInput}"/>
                    <Label Content="账号" Target="{Binding ElementName=LoginAccount}"/>
                    <TextBox x:Name="LoginAccount" Style="{StaticResource ChatInput}"/>
                    <Label Content="密码" Target="{Binding ElementName=LoginPassword}"/>
                    <PasswordBox x:Name="LoginPassword" Padding="8,5"/>
                    <Label Content="谷歌验证码（开启后台验证时填写）" Target="{Binding ElementName=GoogleCode}"/>
                    <TextBox x:Name="GoogleCode" MaxLength="6" Style="{StaticResource ChatInput}"/>
                    <TextBlock x:Name="LoginError" Foreground="#9F2937" TextWrapping="Wrap" Margin="0,10,0,8"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="CancelLoginButton" Content="取消" Click="CancelLogin" IsCancel="False"/>
                        <Button x:Name="LoginButton" Style="{StaticResource ChatPrimaryAction}" Content="登录" Click="Login" IsDefault="True"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
