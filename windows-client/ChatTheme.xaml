<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="ChatInk" Color="#202D2B"/>
    <SolidColorBrush x:Key="ChatMuted" Color="#586762"/>
    <SolidColorBrush x:Key="ChatLine" Color="#DEE5E2"/>
    <SolidColorBrush x:Key="ChatRail" Color="#1C2B2B"/>
    <SolidColorBrush x:Key="ChatDirectory" Color="#F7F9F8"/>
    <SolidColorBrush x:Key="ChatCanvas" Color="#EEF2F0"/>
    <SolidColorBrush x:Key="ChatAccent" Color="#107457"/>
    <SolidColorBrush x:Key="ChatTint" Color="#E2F0EA"/>
    <SolidColorBrush x:Key="ChatSelected" Color="#DCEFE7"/>
    <SolidColorBrush x:Key="OutgoingBubble" Color="#D6F1E4"/>
    <SolidColorBrush x:Key="OutgoingBorder" Color="#C1E2D4"/>
    <SolidColorBrush x:Key="ChatUnread" Color="#A63747"/>

    <SolidColorBrush x:Key="ChatRailActive" Color="#36554B"/>
    <SolidColorBrush x:Key="ChatInset" Color="#EDF1EF"/>
    <SolidColorBrush x:Key="ChatBubbleEdge" Color="#E2E9E5"/>

    <DrawingBrush x:Key="ChatAvatarMask" Stretch="Fill">
        <DrawingBrush.Drawing>
            <GeometryDrawing Brush="White">
                <GeometryDrawing.Geometry>
                    <RectangleGeometry Rect="0,0,36,36" RadiusX="9" RadiusY="9"/>
                </GeometryDrawing.Geometry>
            </GeometryDrawing>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <Style x:Key="ChatDirectoryRow" TargetType="ListBoxItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Padding" Value="9,8"/>
        <Setter Property="Margin" Value="0,2"/>
        <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Row" Background="Transparent" CornerRadius="10" Padding="{TemplateBinding Padding}" BorderThickness="2,0,0,0" BorderBrush="Transparent">
                        <ContentPresenter HorizontalAlignment="Stretch"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{StaticResource ChatTint}"/></Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{StaticResource ChatSelected}"/>
                            <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource ChatAccent}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource ChatAccent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ChatRailLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Margin" Value="0,4,0,0"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="ChatRailIcon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
        <Setter Property="FontSize" Value="17"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="ChatToolbarIcon" TargetType="TextBlock" BasedOn="{StaticResource ChatRailIcon}">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,5,0"/>
    </Style>

    <Style x:Key="ChatRailAction" TargetType="Button">
        <Setter Property="Foreground" Value="#D4E2DE"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Padding" Value="2,4"/>
        <Setter Property="Margin" Value="0,0,0,5"/>
        <Setter Property="MinHeight" Value="45"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#344843"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#AFE3CF"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value=".75"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value=".5"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ChatQuietAction" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource ChatInk}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="MinHeight" Value="31"/>
        <Setter Property="Padding" Value="9,4"/>
        <Setter Property="Margin" Value="0,0,5,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{StaticResource ChatTint}"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource ChatAccent}"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value=".72"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value=".48"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ChatPrimaryAction" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Background" Value="{StaticResource ChatAccent}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderBrush" Value="{StaticResource ChatAccent}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="MinHeight" Value="34"/>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="#EDF1EF"/>
                <Setter Property="BorderBrush" Value="#EDF1EF"/>
                <Setter Property="Foreground" Value="#65736D"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ChatCompactTool" TargetType="Button" BasedOn="{StaticResource ChatQuietAction}">
        <Setter Property="MinWidth" Value="32"/>
        <Setter Property="Padding" Value="5,3"/>
        <Setter Property="Margin" Value="0,0,3,0"/>
    </Style>
    <Style x:Key="ChatCompactIcon" TargetType="TextBlock" BasedOn="{StaticResource ChatToolbarIcon}">
        <Setter Property="Margin" Value="0"/>
        <Setter Property="FontSize" Value="16"/>
    </Style>

    <Style x:Key="ChatFilter" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource ChatMuted}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Surface" Background="Transparent" CornerRadius="6" Padding="4,5"
                            BorderBrush="Transparent" BorderThickness="1">
                        <ContentPresenter HorizontalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{StaticResource ChatTint}"/></Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="White"/>
                            <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource ChatLine}"/>
                            <Setter Property="Foreground" Value="{StaticResource ChatAccent}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource ChatAccent}"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ChatInput" TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource ChatInk}"/>
        <Setter Property="CaretBrush" Value="{StaticResource ChatAccent}"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="{StaticResource ChatLine}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="9,7"/>
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Surface" CornerRadius="9" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ScrollViewer x:Name="PART_ContentHost"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource ChatAccent}"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Background" Value="{StaticResource ChatCanvas}"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ChatSearchInput" TargetType="TextBox" BasedOn="{StaticResource ChatInput}">
        <Setter Property="Background" Value="{StaticResource ChatInset}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style x:Key="ChatComposeInput" TargetType="TextBox" BasedOn="{StaticResource ChatInput}">
        <Setter Property="Background" Value="{StaticResource ChatDirectory}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="FontSize" Value="14"/>
    </Style>
</ResourceDictionary>
