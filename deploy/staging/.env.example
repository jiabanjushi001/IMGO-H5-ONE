# 复制为 deploy/staging/.env 或服务器上的 /etc/imgo-staging/imgo.env。
# 所有 REPLACE_ 值必须更换；预发布严禁连接正式数据库。
IMGO_ADDR=127.0.0.1:18080
IMGO_TCP_ADDR=0.0.0.0:19090
IMGO_TCP_TLS_CERT=/etc/letsencrypt/live/tcp-staging.example.com/fullchain.pem
IMGO_TCP_TLS_KEY=/etc/letsencrypt/live/tcp-staging.example.com/privkey.pem

MYSQL_DSN='imgo_staging:REPLACE_WITH_DB_PASSWORD@tcp(10.0.0.10:3306)/imgo_staging?charset=utf8mb4&parseTime=true&loc=Local'
TABLE_PREFIX=yu_
JWT_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
CHAT_KEY=REPLACE_WITH_AN_INDEPENDENT_STAGING_CHAT_KEY

PUBLIC_DIR=/opt/imgo-staging/public
BASE_URL=https://api-staging.example.com
QR_BASE_URL=https://api-staging.example.com
H5_URL=https://app-staging.example.com
INVITE_URL='https://app-staging.example.com/#/pages/login/register?token='

IP_DATABASE=/opt/imgo-staging/data/17monipdb.dat
FFMPEG_BIN=/usr/bin/ffmpeg
FFPROBE_BIN=/usr/bin/ffprobe
MAINTENANCE_ENABLED=false

# 可选外部服务。预发布建议使用沙箱账号，不能复用正式密钥。
SMTP_ADDR=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
API_APP_ID=
API_SECRET=
THINKAPI_TOKEN=
